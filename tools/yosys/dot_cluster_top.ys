# Yosys command body for dot_cluster_top proxy synthesis.
# Prefer tools/yosys/run_dot_cluster_proxy.sh, which runs sv2v first and
# supplies TOP, TARGET_NS, and LIBERTY_PATH consistently.

read_verilog ${SV2V_OUT}
hierarchy -check -top ${TOP}
proc; opt; fsm; opt; memory; opt
async2sync; opt
techmap; opt
abc -liberty ${LIBERTY_PATH} -D ${TARGET_PS}
clean
stat -liberty ${LIBERTY_PATH}
